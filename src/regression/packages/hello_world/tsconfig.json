{
    "compilerOptions": {
        "target": "es2020",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": false,
        "strictNullChecks": true,
        "skipLibCheck": true
    },
    "extends": "assemblyscript/std/assembly.json"
}
